{
  "defaults": {
    "base_dir": "./repos",
    "base_url": "https://github.com/miacro"
  },
  "repos": [
    {
      "repo": "utils",
      "commands": [{
        "cwd": "./repos/utils",
        "cmd": "make reinstall"
      }]
    },
    {
      "repo": "emacs.d",
      "commands": [{
        "cwd": "$dest",
        "cmd": "make reinstall"
      }]
    },
    {
      "repo": "vim.d",
      "commands": [{
        "cwd": "$dest",
        "cmd": "make all"
      }]
    },
    {
      "repo": "stumpwm.d"
    },
    {
      "repo": "bootstrap"
    },
    {
      "repo": "profiles"
    },
    {
      "repo": "nginx.d"
    },
    {
      "repo": "lisp-koans"
    },
    {
      "repo": "miacropp"
    },
    {
      "repo": "datasets"
    },
    {
      "repo": "minesweeper"
    },
    {
      "repo": "online-judge"
    },
    {
      "repo": "container-recipes"
    },
    {
      "repo": "miacro.github.io"
    },
    {
      "repo": "miacro-overlay"
    },
    {
      "repo": "dotfiles"
    }
  ]
}
